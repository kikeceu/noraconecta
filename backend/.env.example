# ── Marca ──────────────────────────────────
APP_NAME=NORA
APP_FULL_NAME=NORA Conecta
APP_TAGLINE=Tu profesional de confianza
APP_URL=https://noraconecta.com

# ── Base de datos ──────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/noraconecta?schema=public"

# ── Autenticación ──────────────────────────
JWT_SECRET="change-me-to-a-random-string"
PORT=3000
APP_URL="http://app.noraconecta.local"

# ── Cloudflare R2 ──────────────────────────
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ── Seed ───────────────────────────────────
SEED_ADMIN_EMAIL="admin@noraconecta.com"
SEED_ADMIN_PASSWORD="Admin123!"

# ── LLM (OpenAI) ───────────────────────────
OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"  # opcional, para proxies/alternativas
# LLM_MODEL="gpt-4o-mini"                       # opcional, default: gpt-4o-mini

# ── WhatsApp Business API ──────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID_USER=
WHATSAPP_PHONE_NUMBER_ID_PROFESSIONAL=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_VERSION=v19.0

# ── MercadoPago ────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=         # Access token de producción o sandbox
MERCADOPAGO_WEBHOOK_SECRET=       # Secret para validar firma del webhook
MERCADOPAGO_SUCCESS_URL=https://noraconecta.com.ar/pago-exitoso
MERCADOPAGO_FAILURE_URL=https://noraconecta.com.ar/pago-fallido
MERCADOPAGO_PENDING_URL=https://noraconecta.com.ar/pago-pendiente
