# ── Marca ──────────────────────────────────
APP_NAME=NORA
APP_FULL_NAME=NORA Conecta
APP_TAGLINE=Tu profesional de confianza
APP_URL=http://app.noraconecta.local

# ── Base de datos ──────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/noraconecta?schema=public"

# ── Autenticación ──────────────────────────
JWT_SECRET="change-me-to-a-random-string"
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ── Cloudflare R2 ──────────────────────────
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ── Seed ───────────────────────────────────
SEED_ADMIN_EMAIL="admin@noraconecta.com"
SEED_ADMIN_PASSWORD="Admin123!"

# ── LLM Provider ────────────────────────────
LLM_PROVIDER=openai                          # openai | anthropic
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_BASE_URL="https://api.openai.com/v1"  # opcional, para proxies/alternativas
# LLM_MODEL="gpt-4o-mini"                       # opcional, default: gpt-4o-mini (usado por llm.ts)

# ── WhatsApp Business API ──────────────────────────────────────────────────
# Proveedor: Kapso (https://kapso.ai) o Meta directo
#
# Con Kapso:
#   WHATSAPP_BASE_URL=https://api.kapso.ai/meta/whatsapp
#   WHATSAPP_API_TOKEN_USER=api key del proyecto de usuarios en Kapso
#   WHATSAPP_API_TOKEN_PROFESSIONAL=api key del proyecto de profesionales en Kapso
#   WHATSAPP_PHONE_NUMBER_ID_USER=id del numero de usuarios en Kapso
#   WHATSAPP_PHONE_NUMBER_ID_PROFESSIONAL=id del numero de profesionales en Kapso
#   WHATSAPP_APP_SECRET=webhook secret generado por Kapso (Kapso -> Webhooks)
#
# Con Meta directo:
#   WHATSAPP_BASE_URL=https://graph.facebook.com
#   WHATSAPP_API_TOKEN_USER=token permanente del system user de Meta (usuarios)
#   WHATSAPP_API_TOKEN_PROFESSIONAL=token permanente del system user de Meta (profesionales)
#   WHATSAPP_PHONE_NUMBER_ID_USER=phone_number_id del numero de usuarios en Meta
#   WHATSAPP_PHONE_NUMBER_ID_PROFESSIONAL=phone_number_id del numero de profesionales en Meta
#   WHATSAPP_APP_SECRET=app secret del BM en Meta developers
#
# Modo dual BM (pruebas con dos apps de Meta separadas):
#   WHATSAPP_APP_SECRET_USER=App Secret de la app del BM de usuarios
#   WHATSAPP_APP_SECRET_PROFESSIONAL=App Secret de la app del BM de profesionales
#   Si ambos están seteados, se usa el correspondiente según el phone_number_id del webhook.
#   Si solo WHATSAPP_APP_SECRET está seteado, se usa ese para ambos (single WABA).
#
# Servicio de Mensajes: CLOUD_API (Meta directo) | KAPSO (vía Kapso)
#   WHATSAPP_SERVICE=CLOUD_API
#   Con KAPSO: WHATSAPP_SERVICE=KAPSO

WHATSAPP_BASE_URL=https://api.kapso.ai/meta/whatsapp
WHATSAPP_API_TOKEN_USER=
WHATSAPP_API_TOKEN_PROFESSIONAL=
WHATSAPP_PHONE_NUMBER_ID_USER=
WHATSAPP_PHONE_NUMBER_ID_PROFESSIONAL=
WHATSAPP_WEBHOOK_SECRET=noraconecta2026
WHATSAPP_API_VERSION=v19.0
WHATSAPP_APP_SECRET=
WHATSAPP_APP_SECRET_USER=
WHATSAPP_APP_SECRET_PROFESSIONAL=
# WHATSAPP_SERVICE=CLOUD_API

# ── MercadoPago ────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=         # Access token de producción o sandbox
MERCADOPAGO_WEBHOOK_SECRET=       # Secret para validar firma del webhook
MERCADOPAGO_SUCCESS_URL=https://noraconecta.com.ar/pago-exitoso
MERCADOPAGO_FAILURE_URL=https://noraconecta.com.ar/pago-fallido
MERCADOPAGO_PENDING_URL=https://noraconecta.com.ar/pago-pendiente
