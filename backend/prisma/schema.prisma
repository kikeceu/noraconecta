generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum AdminRole {
  SUPERADMIN
  OPERATOR
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GeoLevel {
  id        String   @id @default(cuid())
  countryId String
  country   GeoNode  @relation("GeoCountry", fields: [countryId], references: [id])
  level     Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes GeoNode[]

  @@unique([countryId, level])
}

model GeoNode {
  id        String   @id @default(cuid())
  name      String
  levelId   String?
  level     GeoLevel? @relation(fields: [levelId], references: [id])
  parentId  String?
  parent    GeoNode?  @relation("GeoTree", fields: [parentId], references: [id])
  children  GeoNode[] @relation("GeoTree")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  geoLevels          GeoLevel[]          @relation("GeoCountry")
  professionalZones  ProfessionalZone[]
  requests           Request[]

  @@index([parentId])
  @@index([levelId])
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ProfessionalStatus {
  PENDING
  UNDER_REVIEW
  ACTIVE
  OBSERVATION
  SUSPENDED
  PAUSED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELED
}

enum MembershipType {
  MONTHLY
  ANNUAL
}

enum RequestStatus {
  CREATED
  ASSIGNED
  ACCEPTED
  PENDING_CONFIRMATION
  CANCELLED
  NO_RESPONSE
  COMPLETED
  NOT_FULFILLED
}

enum RequestEventType {
  ASSIGNED
  ACCEPTED
  REJECTED
  NO_RESPONSE
  PENDING_CONFIRMATION
  COMPLETED
  NOT_FULFILLED
  CANCELLED
}

enum EscalationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum LicenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BotRole {
  USER
  PROFESSIONAL
}

enum ProfessionalEventType {
  PANEL_INTRO_ACCEPTANCE
  PANEL_INTRO_COMPLETION
  DIDI_VERIFICATION_SENT
  DIDI_VERIFICATION_COMPLETED
  WHATSAPP_FLOW_REGISTERED
  MERCADO_PAGO_CONNECTED
  FIRST_PAYMENT_RECEIVED
}

model Category {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  description      String?
  isActive         Boolean  @default(true)
  requiresLicense  Boolean  @default(false)
  licenseLabel     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  professionals Professional[]
  requests      Request[]
}

model User {
  id                 String     @id @default(cuid())
  phone              String     @unique
  name               String
  status             UserStatus @default(ACTIVE)
  abuseWarningCount  Int        @default(0)
  lastAbuseCheckAt   DateTime?
  savedLocations     Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  requests    Request[]
  escalations Escalation[]
}

model Professional {
  id                    String             @id @default(cuid())
  phone                 String             @unique
  name                  String
  status                ProfessionalStatus @default(PENDING)
  categoryId            String
  category              Category           @relation(fields: [categoryId], references: [id])
  availability          String?
  verificationToken     String             @unique
  verificationTokenExp  DateTime
  verificationTokenUsed Boolean            @default(false)
  sessionToken          String?            @unique
  sessionTokenExp       DateTime?
  dniNumber             String?
  dniFrontUrl           String?
  dniBackUrl            String?
  cuil                  String?
  criminalRecordUrl     String?
  references            String?
  presentationVideoUrl  String?
  hasBadge              Boolean            @default(false)
  trialRequestsUsed     Int                @default(0)
  lastAssignedAt        DateTime?
  latitude              Float?
  longitude             Float?
  availabilityStructured Json?
  problemTypeStats       Json?
  abuseWarningCount      Int                @default(0)
  lastAbuseCheckAt       DateTime?
  declaredHasLicense     Boolean?
  licenseUrl             String?
  licenseStatus          LicenseStatus?     @default(PENDING)

  zones       ProfessionalZone[]
  memberships Membership[]
  requests    Request[]          @relation("AssignedProfessional")
  events           RequestEvent[]
  dataChangeRequests  ProfessionalDataChangeRequest[]
  professionalEvents  ProfessionalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
}

model ProfessionalDataChangeRequest {
  id             String   @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  changedFields  Json
  previousValues Json?
  newValues      Json?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?

  @@index([professionalId])
  @@index([status])
}

model ProfessionalEvent {
  id             String                 @id @default(cuid())
  professionalId String
  type           ProfessionalEventType
  metadata       Json?
  createdAt      DateTime               @default(now())
  professional   Professional           @relation(fields: [professionalId], references: [id])

  @@index([professionalId, type])
}

model ProfessionalZone {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  geoNodeId      String
  geoNode        GeoNode      @relation(fields: [geoNodeId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([professionalId, geoNodeId])
  @@index([geoNodeId])
}

model Plan {
  id                String  @id @default(cuid())
  name              String  @unique
  monthlyPrice      Float
  annualDiscountPct Float
  priority          Int     @default(1)
  isActive          Boolean @default(true)
  features          Json?

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id                    String           @id @default(cuid())
  professionalId        String
  professional          Professional     @relation(fields: [professionalId], references: [id])
  planId                String
  plan                  Plan             @relation(fields: [planId], references: [id])
  type                  MembershipType
  status                MembershipStatus @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime
  paymentRef            String?
  activatedBy           String?
  renewalReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Request {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id])
  categoryId             String
  category               Category      @relation(fields: [categoryId], references: [id])
  geoNodeId              String
  geoNode                GeoNode       @relation(fields: [geoNodeId], references: [id])
  description            String
  photoUrls              String[]
  audioUrl               String?
  status                 RequestStatus @default(CREATED)
  assignedProfessionalId String?
  assignedProfessional   Professional? @relation("AssignedProfessional", fields: [assignedProfessionalId], references: [id])
  assignedAt             DateTime?
  acceptedAt             DateTime?
  completedAt            DateTime?
  assignmentTimeoutAt    DateTime?
  scheduledAt            DateTime?
  clientAddress          String?
  clientNeighborhood     String?
  clientPostalCode       String?
  clientAvailability     String?
  coordinationStatus     String?
  negotiationRounds      Int           @default(0)
  waitingUserConsent     Boolean?      @default(false)
  waitingActivationSince DateTime?
  userLatitude           Float?
  userLongitude          Float?
  problemType            String?
  isUrgent               Boolean  @default(false)
  mentionedDate          String?
  technicalBrief         String?
  reminderSentAt         DateTime?

  events     RequestEvent[]
  feedback   Feedback?
  escalation Escalation?
  pricing    RequestPricing?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([categoryId, geoNodeId, status])
  @@index([assignedProfessionalId, status])
  @@index([assignmentTimeoutAt, status])
}

model RequestEvent {
  id             String           @id @default(cuid())
  requestId      String
  request        Request          @relation(fields: [requestId], references: [id])
  professionalId String?
  professional   Professional?    @relation(fields: [professionalId], references: [id])
  type           RequestEventType
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([requestId])
  @@index([professionalId])
}

model Feedback {
  id        String  @id @default(cuid())
  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id])

  // User → Professional rating
  rating                Int?
  punctualityRating     Int?
  qualityRating         Int?
  communicationRating   Int?
  priceFairnessRating   Int?
  wouldRecommend        Boolean?
  userComment           String?
  ratedByUserAt         DateTime?

  // Professional → User rating
  requestClarityRating   Int?
  userAvailabilityRating Int?
  userTreatmentRating    Int?
  wouldServeAgain        Boolean?
  professionalComment    String?
  ratedByProfessionalAt  DateTime?

  sentimentAnalysis Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Escalation {
  id             String           @id @default(cuid())
  requestId      String           @unique
  request        Request          @relation(fields: [requestId], references: [id])
  reportedBy     String
  user           User             @relation(fields: [reportedBy], references: [id])
  professionalId String
  status         EscalationStatus @default(OPEN)
  resolution     String?
  resolvedBy     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model RequestPricing {
  id          String                     @id @default(cuid())
  requestId   String                     @unique
  request     Request                    @relation(fields: [requestId], references: [id])
  amountPaid  Int?
  currency    String                     @default("ARS")
  reportedAt  DateTime?
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([requestId])
  @@index([reportedAt])
}

model BotSession {
  id          String   @id @default(cuid())
  phone       String
  role        BotRole
  currentFlow String?
  currentStep String?
  tempData      Json?
  lastInboundAt   DateTime?
  reminderSentAt     DateTime?
  lastTemplateSentAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([phone, role])
}

model BotSecurity {
  id              String    @id @default(cuid())
  phone           String    @unique
  messageCount    Int       @default(0)
  windowStart     DateTime  @default(now())
  suspiciousCount Int       @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([phone])
  @@index([blockedUntil])
}

model PromptTemplate {
  key            String   @id
  content        String   @db.Text
  defaultContent String   @db.Text
  description    String
  variables      String[]
  isEditable     Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model ProfessionalRequestSession {
  id          String   @id @default(cuid())
  phone       String
  requestId   String   @unique
  currentStep String
  tempData    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
}
