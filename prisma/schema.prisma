generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPERADMIN
  OPERATOR
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GeoLevel {
  id        String   @id @default(cuid())
  countryId String
  country   GeoNode  @relation("GeoCountry", fields: [countryId], references: [id])
  level     Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes GeoNode[]

  @@unique([countryId, level])
}

model GeoNode {
  id        String   @id @default(cuid())
  name      String
  levelId   String?
  level     GeoLevel? @relation(fields: [levelId], references: [id])
  parentId  String?
  parent    GeoNode?  @relation("GeoTree", fields: [parentId], references: [id])
  children  GeoNode[] @relation("GeoTree")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  geoLevels GeoLevel[] @relation("GeoCountry")

  @@index([parentId])
  @@index([levelId])
}
